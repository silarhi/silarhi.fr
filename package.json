{
    "name": "silarhi.fr",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "next build",
        "start": "next start",
        "lint": "biome check src scripts",
        "lint:fix": "biome check --write src scripts",
        "knip": "knip",
        "lint-ci": "yarn lint && yarn typecheck && yarn knip && yarn validate:technologies && yarn validate:clients && yarn validate:images",
        "validate:technologies": "tsx scripts/validate-technologies.ts",
        "validate:clients": "tsx scripts/validate-clients.ts",
        "validate:urls": "tsx scripts/validate-urls.ts",
        "validate:images": "tsx scripts/validate-images.ts",
        "generate:image-metadata": "tsx scripts/generate-image-metadata.ts",
        "typecheck": "tsc --noEmit",
        "prettier": "prettier --write \"**/*.{css,scss,md,mdx,yaml,yml}\"",
        "prettier:check": "prettier --check \"**/*.{css,scss,md,mdx,yaml,yml}\"",
        "size": "size-limit",
        "size:json": "size-limit --json",
        "prepare": "husky"
    },
    "dependencies": {
        "@types/hast": "^3.0.5",
        "clsx": "^2.1.1",
        "fuse.js": "^7.5.0",
        "gray-matter": "^4.0.3",
        "hast": "^1.0.0",
        "next": "16.4.0",
        "next-mdx-remote": "^6.0.0",
        "next-themes": "^0.4.6",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hook-form": "^7.89.0",
        "react-icons": "^5.7.0",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-slug": "^6.0.0",
        "rehype-unwrap-images": "^1.0.0",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.7.0",
        "unist-util-visit": "^5.1.0",
        "use-debounce": "^10.1.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@size-limit/file": "^14.1.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "autoprefixer": "^10.6.1",
        "husky": "^9.1.7",
        "knip": "^6.40.0",
        "lint-staged": "^17.6.0",
        "postcss": "^8.5.29",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "sass": "^1.105.1",
        "sharp": "^0.35.5",
        "size-limit": "^14.1.0",
        "svgo": "^4.1.0",
        "svgo-add-viewbox": "^3.1.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs,cjs,json}": "biome check --write --no-errors-on-unmatched",
        "*.{css,scss,md,mdx,yaml,yml}": "prettier --write"
    }
}
